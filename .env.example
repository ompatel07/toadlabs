# Razorpay — /playbook checkout.
# Copy to .env (already gitignored) for local testing, and set the same names
# in Netlify → Site settings → Environment variables.
#
# Use TEST keys (rzp_test_...) until the live flow has been verified end to end.

# Public key id. Safe to reach the browser: it identifies the merchant only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Secret. Server-side only. Never prefix with NEXT_PUBLIC_, never import in a
# component. It also signs the download tokens.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Set when you create the webhook in the Razorpay dashboard. The webhook
# function rejects every call that is not signed with this.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL. An independent key for signing download links. Leave unset and one
# is derived from RAZORPAY_KEY_SECRET with a fixed label, which already keeps
# the signing key separate from the credential that talks to Razorpay. Set it
# if you would rather the two share no origin at all. Changing it invalidates
# every download link already issued.
DOWNLOAD_TOKEN_SECRET=

# Where the paid files actually live — a private Drive/S3/R2 link. The download
# function redirects here only after checking the order is paid. Never commit
# the real value, and never put these files in public/.
PLAYBOOK_DOWNLOAD_URL=https://example.com/replace-me
