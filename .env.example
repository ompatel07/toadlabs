# Razorpay — /playbook checkout.
# Copy to .env (already gitignored) for local testing, and set the same names
# in Netlify → Site settings → Environment variables.
#
# Use TEST keys (rzp_test_...) until the live flow has been verified end to end.

# Public key id. Safe to reach the browser: it identifies the merchant only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Secret. Server-side only. Never prefix with NEXT_PUBLIC_, never import in a
# component. It also signs the download tokens.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Set when you create the webhook in the Razorpay dashboard. The webhook
# function rejects every call that is not signed with this.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL. An independent key for signing download links. Leave unset and one
# is derived from RAZORPAY_KEY_SECRET with a fixed label, which already keeps
# the signing key separate from the credential that talks to Razorpay. Set it
# if you would rather the two share no origin at all. Changing it invalidates
# every download link already issued.
DOWNLOAD_TOKEN_SECRET=

# WHERE THE PAID FILES LIVE — pick ONE of the two options below.
#
# Option A (preferred): Supabase Storage, private bucket. A signed URL is
# minted per download and expires in five minutes, so a link that leaks is
# dead before it is worth anything.
PLAYBOOK_BUCKET=playbook
PLAYBOOK_OBJECT=client-playbook.zip

# Option B: one static link (Drive, Dropbox, R2). Simpler, but it is a single
# URL that works forever for anyone who ends up holding it. Only used when
# PLAYBOOK_BUCKET is unset. Never commit the real value, and never put these
# files in public/.
PLAYBOOK_DOWNLOAD_URL=

# ── Delivery and dashboard ───────────────────────────────────────────────────
# Everything below is OPTIONAL. Leave it unset and the payment flow is exactly
# what it was: the thank-you page hands over the download. Set it and buyers
# also get the link by email, and /playbook/admin lists who bought.

# The site's own origin, with no trailing slash. An emailed link has no origin
# to resolve against, so without this no email is sent at all.
SITE_URL=https://offscript.example

# Supabase → Project Settings → API. Three variables, not five: the dashboard
# page is a Server Component, so it reads these directly and hands the values
# down — no NEXT_PUBLIC_ copies to set and keep in step.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable. It is only used to ask Supabase "is this login token real?".
SUPABASE_ANON_KEY=
# ⚠️ SERVER ONLY. Bypasses row-level security entirely. Netlify env vars only,
# never NEXT_PUBLIC_, never imported by anything under src/.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. Sending needs a verified domain; without one Resend will
# only deliver to the address that owns the account, which is fine for testing
# and useless for buyers.
RESEND_API_KEY=
MAIL_FROM=OFFSCRIPT <playbook@yourdomain.com>
SUPPORT_EMAIL=hello@yourdomain.com

# Comma-separated. The ONLY accounts allowed to open the dashboard; a valid
# Supabase login that is not on this list is refused.
ADMIN_EMAILS=you@yourdomain.com

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# The floating chat button redirects through a function so this never appears
# in the HTML of any page. Digits only, with the country code.
WHATSAPP_NUMBER=919999999999
